# Host paths (mounted at /workspace/models and /workspace/real-pa inside the containers)
MODELS_ROOT=/workspace/models
CONFIG_DIR=/workspace/real-pa
# Owner of CONFIG_DIR (`id -u` / `id -g`); the configure step writes there as this user
HOST_UID=1000
HOST_GID=1000
# Browser/Lemmy-facing origin allowed by the API (the TLS proxy's public URL)
PUBLIC_ORIGIN=http://localhost:18484
API_PORT=18484
# LLM
LLM_IMAGE=localforge/llama-cuda:56b9eb280a67
LLM_CONTEXT=8192
LLM_CACHE_MIB=256
# TLS proxy (profile "tls")
TLS_DIR=/etc/real-pa/tls
